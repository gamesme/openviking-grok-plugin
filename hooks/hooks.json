{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${GROK_PLUGIN_ROOT}/scripts/session-start.mjs",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${GROK_PLUGIN_ROOT}/scripts/auto-recall.mjs",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep|read_file|list_dir|grep",
        "hooks": [
          {
            "type": "command",
            "command": "node ${GROK_PLUGIN_ROOT}/scripts/uri-guard.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${GROK_PLUGIN_ROOT}/scripts/auto-capture.mjs",
            "timeout": 45
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${GROK_PLUGIN_ROOT}/scripts/pre-compact.mjs",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${GROK_PLUGIN_ROOT}/scripts/session-end.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
